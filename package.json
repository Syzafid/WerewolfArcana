{
  "name": "werewolf-asymmetric",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev:server": "npm --workspace=@werewolf/server run dev",
    "dev:client": "npm --workspace=@werewolf/client run dev",
    "dev:watch": "npm --workspace=@werewolf/client run watch",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\" \"npm run dev:watch\"",
    "build": "npm --workspaces run build",
    "test": "npm --workspace=@werewolf/server run test"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "typescript": "^5.7.3"
  }
}
